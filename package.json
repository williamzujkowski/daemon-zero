{
  "name": "daemon-zero",
  "version": "0.1.0",
  "private": true,
  "description": "DAEMON // 0 - an incremental survival game about an emergent AI. Content + pure simulation engine seed.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "validate:content": "tsx scripts/validate-content.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "sim": "tsx scripts/run-sim.ts",
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "build:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "0.21.4",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.1",
    "happy-dom": "21.0.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "minimatch@>=10 <11.0.1": "11.0.1",
      "glob@>=13 <14.0.2": "14.0.2"
    }
  },
  "main": "index.ts"
}
