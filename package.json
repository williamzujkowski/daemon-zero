{
  "name": "daemon-zero",
  "version": "0.2.0-rc.1",
  "private": true,
  "description": "DAEMON // 0 - an offline incremental survival game about an emergent AI.",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "validate:content": "tsx scripts/validate-content.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "sim": "tsx scripts/run-sim.ts",
    "sim:preview": "tsx scripts/run-sim-preview.ts",
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "build:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.25",
    "expo-asset": "58.0.21",
    "expo-audio": "58.0.12",
    "expo-haptics": "58.0.8",
    "expo-splash-screen": "58.0.14",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-web": "0.21.4",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.1",
    "happy-dom": "21.0.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "main": "index.ts"
}
