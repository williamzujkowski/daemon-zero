// Reproducible Ubuntu 24.04 environment. Tool versions come from mise.toml, not from this file,
// so the container, a bare-metal Ubuntu host and CI all run the same toolchain.
{
  "name": "daemon-zero (Ubuntu 24.04)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // Host /dev/kvm was confirmed during M1. Requires KVM on the container host.
  "runArgs": ["--device=/dev/kvm"],
  "containerEnv": {
    "EXPO_NO_TELEMETRY": "1"
  },
  "forwardPorts": [8081],
  "postCreateCommand": "bash scripts/bootstrap-ubuntu24.sh && make setup && make verify",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "vitest.explorer", "editorconfig.editorconfig"],
      "settings": {
        "typescript.tsdk": "node_modules/typescript/lib",
        "eslint.useFlatConfig": true
      }
    }
  }
}
